{
  "name": "@temirtator/kazmaps-design-system",
  "version": "0.4.0",
  "description": "KazMaps design system — multi-brand UI kit (tokens, atoms, molecules) for Tailwind v4 + React 19 apps",
  "type": "module",
  "license": "MIT",
  "author": "Temirlan Shagyrov <sh.temirlan95@gmail.com>",
  "repository": {
    "type": "git",
    "url": "https://github.com/Temirtator/kazmaps-design-system.git"
  },
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./maps": {
      "types": "./dist/maps/index.d.ts",
      "import": "./dist/maps/index.js"
    },
    "./styles/core.css": "./dist/styles/core.css",
    "./styles/theme.css": "./dist/styles/theme.css",
    "./styles/brands/business.css": "./dist/styles/brands/business.css",
    "./styles/brands/booking.css": "./dist/styles/brands/booking.css",
    "./styles/brands/maps.css": "./dist/styles/brands/maps.css",
    "./styles/kits/maps.css": "./dist/styles/kits/maps.css"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "tokens:build": "node scripts/build-tokens.mjs",
    "tokens:check": "npm run tokens:build && git diff --quiet --exit-code -- src/styles docs/tokens.md",
    "test": "npm run tokens:check && vitest run --passWithNoTests",
    "test:watch": "vitest",
    "test:vrt": "storybook build && playwright test --project=vrt",
    "test:vrt:update": "storybook build && playwright test --project=vrt --update-snapshots",
    "test:e2e": "storybook build && playwright test --project=interactions",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "prepublishOnly": "npm run lint && npm run typecheck && npm run test && npm run build",
    "prepare": "husky"
  },
  "peerDependencies": {
    "lucide-react": "^1.0.0",
    "qrcode": "^1.5.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "peerDependenciesMeta": {
    "qrcode": {
      "optional": true
    }
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "react-input-mask-format": "2.2.0",
    "tailwind-merge": "^3.6.0"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{css,md,json,mjs}": [
      "prettier --write"
    ]
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.5.3",
    "@commitlint/config-conventional": "^20.5.3",
    "@playwright/test": "^1.61.1",
    "@storybook/addon-a11y": "^10.5.3",
    "@storybook/react-vite": "^10.5.0",
    "@tailwindcss/vite": "^4.3.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^26.1.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "axe-core": "^4.12.1",
    "eslint": "^10.7.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "http-server": "^14.1.1",
    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "lint-staged": "^16.4.0",
    "lucide-react": "^1.24.0",
    "prettier": "3.9.5",
    "qrcode": "^1.5.4",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-hook-form": "^7.87.0",
    "storybook": "^10.5.0",
    "tailwindcss": "^4.3.2",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.64.0",
    "vitest": "^4.1.10"
  }
}
